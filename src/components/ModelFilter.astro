---
import { MODELS, type ModelKey } from '../lib/catalog';

interface Props {
  active: ModelKey | null;
  available: ModelKey[];
}
const { active, available } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<div class="ids__promo-link">
  <a href={`${base}/`} class={active === null ? 'active' : undefined}>Все</a>
  {available.map((key) => (
    <a
      href={`${base}/${MODELS[key].slug}/`}
      class={active === key ? 'active' : undefined}
    >{MODELS[key].label}</a>
  ))}
</div>
